{
  "name": "baekstage",
  "version": "0.2.0",
  "description": "Visualize, run, and review branching Playwright scenarios as an interactive graph.",
  "license": "MIT",
  "keywords": ["playwright", "testing", "scenario", "graph", "visualization", "react"],
  "type": "module",
  "main": "./dist-lib/baekstage.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist-lib/baekstage.js"
    },
    "./playwright": {
      "types": "./dist-types/playwright/index.d.ts",
      "import": "./dist-lib/playwright.js"
    },
    "./config": {
      "types": "./dist-types/config.d.ts",
      "import": "./dist-lib/config.js"
    },
    "./vite": {
      "types": "./dist-types/vite/scenario-plugin.d.ts",
      "import": "./dist-lib/vite.js"
    },
    "./style.css": "./dist-lib/baekstage.css"
  },
  "bin": { "baekstage": "./dist-lib/cli.js" },
  "sideEffects": ["**/*.css"],
  "files": [
    "dist-lib",
    "dist-types",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run build:app && npm run build:lib",
    "build:app": "tsc -b && vite build",
    "clean:lib": "node scripts/build/clean.mjs",
    "build:lib": "npm run clean:lib && vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "test": "vitest run",
    "test:cli": "node scripts/test/cli-smoke.mjs",
    "prepack": "npm test && npm run build:lib"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "react-force-graph-2d": "^1.29.1"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": false }
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public", "provenance": true },
  "author": "codevilot",
  "repository": { "type": "git", "url": "git+https://github.com/codevilot/baekstage.git" },
  "homepage": "https://github.com/codevilot/baekstage#readme",
  "bugs": { "url": "https://github.com/codevilot/baekstage/issues" },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
