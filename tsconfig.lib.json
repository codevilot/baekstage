{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist-types"
  },
  "include": ["src/index.ts", "src/core/**/*.ts", "src/playwright/**/*.ts", "src/viewer/**/*.tsx", "src/vite/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
